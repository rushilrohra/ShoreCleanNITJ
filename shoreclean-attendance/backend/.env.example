# Backend server port
PORT=5000

# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=shoreclean

# Auth JWT secret (used only for user/session auth tokens)
JWT_SECRET=your_auth_jwt_secret_here_min_32_chars

# QR token namespace secret (kept for compatibility/future signing)
# Keep this different from JWT_SECRET.
QR_SECRET=your_qr_token_secret_here_different_from_jwt_secret

# Frontend application URL for CORS
FRONTEND_URL=http://localhost:3000

# Gemini API key for 2-line NGO event description generation
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary configuration for registration photo uploads
CLOUDINARY_CLOUD_NAME=dgu14wde6
CLOUDINARY_API_KEY=712689989212176
CLOUDINARY_API_SECRET=Wrj0Op9U3pao_brl56o_Af2XnQ0

# Enforce strict event-date matching in scanner route.
# Set false for local testing, true for production behavior.
ENFORCE_EVENT_DATE=false
